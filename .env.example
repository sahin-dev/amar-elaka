# ---------------------------------------------------------------
# AmarElaka environment variables — PLACEHOLDERS ONLY.
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------

# MongoDB Atlas connection string (Atlas → Database → Connect → Drivers).
# Use a database user that only has readWrite on the AmarElaka database.
MONGODB_URI=mongodb+srv://sahinsiraj:sahin1122SIRAJ@sahin-dev.vbydzqv.mongodb.net/amarelaka?appName=sahin-dev
MONGODB_DB=amarelaka_dev

# Public base URL of the site (used for share links and Open Graph metadata,
# and for same-origin checks on state-changing API requests).
APP_URL=http://localhost:3000

# Secret used to HMAC client IP addresses for guest rate limits and guest vote
# de-duplication. Raw IPs are never stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=<generate-a-long-random-string>

# Set to "true" only when running behind a proxy that sets X-Forwarded-For
# reliably (e.g. Vercel, Render, Fly). Otherwise IP-based limits use a
# single shared bucket.
TRUST_PROXY=false

# Map tiles (OpenStreetMap-compatible raster XYZ URL). The default public OSM
# tile server is for light development use only — see docs/SERVICES_AND_COSTS.md.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
NEXT_PUBLIC_MAP_MAX_ZOOM=19

# Moderation behaviour
# When true, new reports stay hidden until a moderator approves them.
REPORTS_REQUIRE_APPROVAL=false
# When true (recommended), photos stay hidden until a moderator approves them.
PHOTOS_REQUIRE_APPROVAL=true

# Development-only seed data guard. The dev seed script refuses to run unless
# this is "true" AND NODE_ENV is not "production".
ALLOW_DEV_SEED=false
